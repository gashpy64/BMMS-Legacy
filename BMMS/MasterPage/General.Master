<%@ Master Language="C#" AutoEventWireup="true" Codebehind="General.Master.cs" Inherits="BMMS.MasterPage.General" %>
<%@ Register Src="../UserControl/MenuUserControl.ascx" TagName="MenuUserControl"
    TagPrefix="uc1" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Untitled Page</title>
    <link href="../CSS/MainMaster.css" rel="stylesheet" type="text/css" />
    <link href="../CSS/ddlevelsmenu-topbar.css" rel="stylesheet" type="text/css" />
    <link href="../CSS/CommonHTML.css" rel="stylesheet" type="text/css" />
    <link href="../CSS/ddlevelsmenu-base.css" rel="stylesheet" type="text/css" />
    <link href="../CSS/AjaxCalender.css" rel="stylesheet" type="text/css" />
    <link href="../CSS/PasswordCheck.css" rel="stylesheet" type="text/css" />

    <script type="text/javascript" language="javascript" src="../JScript/BrowserSecurity.js"></script>

</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server">
            <Scripts>
                <asp:ScriptReference Path="~/JScript/ddlevelsmenu.js" />
                <asp:ScriptReference Path="~/JScript/Validation.js" />
            </Scripts>
        </asp:ScriptManager>
        <div id="mainContainer" >
            <div id="logo">
                <p class="welcomeMsg">
                    <br />
                    <br />
                    <br />
                    <br />
                    <a href="../Master/ChangePassword.aspx" style="color:White; font-weight:bold; ">Change Password</a>
                    <b>Logged In :
                        <%=Session["UserName"]%>
                        &nbsp;&nbsp;<asp:LinkButton ID="lnkLogout" runat="server" Text="Logout" ForeColor="white"
                            PostBackUrl="~/Logout.aspx"></asp:LinkButton></b></p>
            </div>
            <div id="divMenu">
                <uc1:MenuUserControl ID="MenuUserControl1" runat="server"></uc1:MenuUserControl>
            </div>
            <div id="contentArea">
                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td class="leftCol" valign="top">
                            <!--Left Column Begin-->
                            <%--<menu:lmenu id="lbl" runat="server" />--%>
                            <!--Left Column End-->
                        </td>
                        <td valign="top">
                            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                            </asp:ContentPlaceHolder>
                        </td>
                    </tr>
                </table>
            </div>
            <div id="footer">
                <asp:Label ID="lblFooter" runat="server" Text="Footer"></asp:Label>
            </div>
        </div>
    </form>
</body>
</html>
